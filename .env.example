# Copy this file to .env for local overrides, or set these as real
# environment variables on your host's dashboard (Render: Web Service ->
# Environment). Never commit an actual .env file — it's already in
# .gitignore.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-freshly-generated-secret-key

# Keep True for local development. Set to False for any real deployment.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve the app. Required
# (non-empty) once DJANGO_DEBUG=False, in addition to whatever
# RENDER_EXTERNAL_HOSTNAME Render already trusts automatically at runtime.
# Example: DJANGO_ALLOWED_HOSTS=dpia-privacy-impact-assessment.example.com
DJANGO_ALLOWED_HOSTS=

# Postgres connection string. Leave unset locally to keep using SQLite.
# Render's Postgres integration provides this as an environment variable
# you can wire in from its dashboard (see README's Deployment section).
DATABASE_URL=
